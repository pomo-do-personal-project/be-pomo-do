{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD",
    "Redis": "YOUR_UPSTASH_ENDPOINT:PORT,password=YOUR_UPSTASH_PASSWORD,ssl=True,abortConnect=False"
  },
  "AdminAccount": {
    "Email": "admin@pomodo.com",
    "Password": "YOUR_ADMIN_PASSWORD",
    "DisplayName": "System Administrator"
  },
  "JwtSettings": {
    "Secret": "YOUR_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
    "Issuer": "pomo-do-backend",
    "Audience": "pomo-do-client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "Pomo-Do",
    "SenderEmail": "your_email@gmail.com",
    "Username": "your_email@gmail.com",
    "Password": "your_16_char_google_app_password",
    "EnableSsl": true,
    "FrontendUrl": "https://localhost:3000"
  }
}
